# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略
# 由 application.yml 的 spring.config.import 读取（按 properties 格式解析）

# profiles
SPRING_PROFILES_ACTIVE=dev

# mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=law_im_message
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# jwt (RS256)：base64(PKCS#8 DER) / base64(X.509 DER)
# 生成：openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out priv.pem
#      openssl pkcs8 -topk8 -nocrypt -in priv.pem -outform DER | base64 | tr -d '\n'
#      openssl rsa -in priv.pem -pubout -outform DER | base64 | tr -d '\n'
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
