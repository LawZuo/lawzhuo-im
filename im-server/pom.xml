<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>law.im</groupId>
        <artifactId>LawIM</artifactId>
        <version>1.0.1</version>
    </parent>

    <artifactId>im-server</artifactId>
    <packaging>jar</packaging>

    <description>Netty服务模块</description>

    <dependencies>
        <dependency>
            <groupId>law.im</groupId>
            <artifactId>im-common</artifactId>
        </dependency>

        <!-- 只需要 Spring 容器能力，不引入 web/tomcat：WS 由 Netty 自己监听端口 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- 协议 JSON 编解码 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!--
          按需引入 Netty 具体模块，版本统一由 spring-boot-dependencies 管理（4.1.135.Final）。
          不要再使用 netty-all：它是内含全部 class 的 uber-jar，和分模块 jar 会重复类，导致 NoSuchMethodError。
        -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-http</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-handler</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>law.imserver.IMServerApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
